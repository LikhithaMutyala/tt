#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main() {
    char str[200];
    int alphabet[26] = {0}; // to mark presence of each letter
    int i, index, isPangram = 1;

    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin); // read input with spaces

    for (i = 0; str[i] != '\0'; i++) {
        if (isalpha(str[i])) { // check if character is a letter
            index = tolower(str[i]) - 'a';
            alphabet[index] = 1; // mark letter as found
        }
    }

    for (i = 0; i < 26; i++) {
        if (alphabet[i] == 0) {
            isPangram = 0;
            break;
        }
    }

    if (isPangram)
        printf("The given string is a Pangram.\n");
    else
        printf("The given string is NOT a Pangram.\n");

    return 0;
}
