#include <stdio.h>

int main() {
    int arr[50], n, i, first;

    printf("Enter size of the array: ");
    scanf("%d", &n);

    printf("Enter elements of the array: ");
    for (i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    first = arr[0]; // store first element

    // Left rotate by one
    for (i = 0; i < n - 1; i++)
        arr[i] = arr[i + 1];

    arr[n - 1] = first; // place first element at the end

    // Print rotated array
    printf("Array after left rotation by one: ");
    for (i = 0; i < n; i++)
        printf("%d ", arr[i]);
    printf("\n");

    return 0;
}
