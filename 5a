#include <stdio.h>

int main() {
    int arr1[50], arr2[50], merged[100];
    int n1, n2, i, j = 0;

    // Input first array
    printf("Enter size of first array: ");
    scanf("%d", &n1);
    printf("Enter elements of first array: ");
    for (i = 0; i < n1; i++)
        scanf("%d", &arr1[i]);

    // Input second array
    printf("Enter size of second array: ");
    scanf("%d", &n2);
    printf("Enter elements of second array: ");
    for (i = 0; i < n2; i++)
        scanf("%d", &arr2[i]);

    // Merge arrays
    for (i = 0; i < n1; i++, j++)
        merged[j] = arr1[i];
    for (i = 0; i < n2; i++, j++)
        merged[j] = arr2[i];

    // Print merged array
    printf("Merged array: ");
    for (i = 0; i < n1 + n2; i++)
        printf("%d ", merged[i]);
    printf("\n");

    return 0;
}
